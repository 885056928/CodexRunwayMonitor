# 复制到 /etc/monitor-usage/usage.env，权限 root:root 0600。
# 两个占位符均须替换为分别生成的32–128字符密钥；服务会拒绝占位符。
Usage__ReportKey=CHANGE_ME_REPORT_KEY_GENERATE_SEPARATELY
Usage__AdminKey=CHANGE_ME_ADMIN_KEY_GENERATE_SEPARATELY
Usage__RequestsPerMinute=600
ASPNETCORE_URLS=http://127.0.0.1:5088
ASPNETCORE_ENVIRONMENT=Production
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
