# 替换 usage.example.com 和证书路径；证书由现有运维流程签发。
server {
    listen 80;
    listen [::]:80;
    server_name usage.example.com;
    access_log off;
    error_log /dev/null crit;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name usage.example.com;
    ssl_certificate /etc/letsencrypt/live/usage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/usage.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 不保留访问IP；error级日志也可能包含连接地址，部署前需审查其保留策略。
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 4k;

    location / {
        proxy_pass http://127.0.0.1:5088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 必须覆盖客户端提供的头，不能使用 $proxy_add_x_forwarded_for。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
