<Window
    x:Class="Monitor.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置 · CodexRunway Monitor"
    Width="590"
    Height="780"
    MinWidth="460"
    MinHeight="450"
    ShowInTaskbar="False"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource Section}"
            Text="监控设置" />
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock
                x:Name="ErrorText"
                MinHeight="42"
                Margin="0,12,0,8"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{DynamicResource DangerBrush}"
                Text="{Binding ErrorText}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="SaveButton"
                    Command="{Binding SaveCommand}"
                    Content="保存设置" />
                <Button
                    x:Name="CancelButton"
                    Content="取消"
                    IsCancel="True"
                    IsEnabled="{Binding CanClose}" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Label Content="API 基础地址" Target="{Binding ElementName=ApiUrl}" />
                <TextBox
                    x:Name="ApiUrl"
                    AutomationProperties.Name="API 基础地址"
                    Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                <Label
                    Margin="0,12,0,0"
                    Content="{Binding IntervalLabel}"
                    Target="{Binding ElementName=Interval}" />
                <TextBox
                    x:Name="Interval"
                    AutomationProperties.Name="检查间隔（分钟）"
                    Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Muted}"
                    Text="默认 5 分钟。手动检查与自动检查共享每小时 20 次额度。" />
                <Label
                    Margin="0,12,0,0"
                    Content="{Binding TimeoutLabel}"
                    Target="{Binding ElementName=TimeoutSeconds}" />
                <TextBox
                    x:Name="TimeoutSeconds"
                    AutomationProperties.Name="请求超时（秒）"
                    Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                <Label
                    Margin="0,12,0,0"
                    Content="提醒自动关闭（秒，0 表示手动关闭）"
                    Target="{Binding ElementName=AutoClose}" />
                <TextBox
                    x:Name="AutoClose"
                    AutomationProperties.Name="提醒自动关闭（秒）"
                    Text="{Binding AutoCloseText, UpdateSourceTrigger=PropertyChanged}" />
                <Separator Margin="0,20" />
                <CheckBox
                    x:Name="AutoStart"
                    Content="程序启动后自动监控"
                    IsChecked="{Binding AutoStartMonitoring}" />
                <CheckBox
                    x:Name="SilentStart"
                    Content="静默启动（不显示主窗口，直接后台监控）"
                    IsChecked="{Binding SilentStart}" />
                <CheckBox
                    x:Name="WindowsStartup"
                    Content="登录 Windows 时自动启动"
                    IsChecked="{Binding StartWithWindows}" />
                <CheckBox
                    x:Name="Tray"
                    Content="关闭或最小化主窗口时进入系统托盘"
                    IsChecked="{Binding MinimizeToTray}" />
                <CheckBox
                    x:Name="Notifications"
                    Content="检测到新事件时显示提醒"
                    IsChecked="{Binding EnableNotification}" />
                <CheckBox
                    x:Name="Sound"
                    Content="提醒时播放系统声音"
                    IsChecked="{Binding EnableSound}" />
                <CheckBox
                    x:Name="Silent"
                    Content="首次成功检查只保存基线，不提醒历史事件"
                    IsChecked="{Binding FirstRunSilent}" />
                <CheckBox
                    x:Name="Logging"
                    Content="保存运行日志"
                    IsChecked="{Binding EnableLogging}" />
                <TextBlock Style="{StaticResource Muted}" Text="关闭通知期间的事件仍会计为已处理；重新开启不会补发。" />
                <Separator Margin="0,20" />
                <CheckBox
                    x:Name="UsageReporting"
                    Content="允许发送使用统计（默认开启）"
                    IsChecked="{Binding EnableUsageReporting}" />
                <TextBlock Style="{StaticResource Muted}"
                    Text="用于统计当前在线设备和公网 IP。开启后每约 60 秒发送随机设备标识和软件版本，服务器从连接获取公网 IP。不读取账号、计算机名或硬件信息；未配置统计服务器时不发送。关闭并保存后停止上报，服务器最迟 3 分钟后移出在线列表。" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

