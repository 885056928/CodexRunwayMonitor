<Window
    x:Class="Monitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexRunway Monitor"
    Width="820"
    Height="780"
    MinWidth="640"
    MinHeight="520"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24">
        <StackPanel Margin="0,0,0,20" DockPanel.Dock="Top">
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Text="CodexRunway" />
            <TextBlock Style="{StaticResource Muted}" Text="额度重置监控" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource Muted}"
                Text="{Binding UsageNotice}" />
            <WrapPanel Margin="0,8,0,0">
                <Button Command="{Binding CheckCommand}" Content="立即检查" />
                <Button Command="{Binding StartCommand}" Content="开始监控" />
                <Button Command="{Binding PauseCommand}" Content="暂停监控" />
                <Button Command="{Binding SettingsCommand}" Content="打开设置" />
                <Button Command="{Binding LogsCommand}" Content="查看日志" />
                <Button Command="{Binding ExitCommand}" Content="退出程序" />
            </WrapPanel>
            <TextBlock
                MinHeight="20"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource Muted}"
                Text="{Binding Feedback}" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Border
                            Margin="0,0,0,20"
                            Padding="14,0,0,0"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="4,0,0,0">
                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{Binding State}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Interval}" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Muted}" Text="上次检查" />
                            <TextBlock Grid.Column="1" Text="{Binding LastCheck}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource Muted}"
                                Text="上次成功检查" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding LastSuccess}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource Muted}"
                                Text="下次预计检查" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding NextCheck}" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource Muted}"
                                Text="网络 / API 状态" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                AutomationProperties.LiveSetting="Polite"
                                Text="{Binding Network}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="最新完成事件" />
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding LatestTime}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Muted}" Text="事件 ID" />
                            <TextBox
                                Grid.Column="1"
                                MinHeight="24"
                                Padding="0"
                                AutomationProperties.Name="事件 ID"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Text="{Binding EventId, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource Muted}"
                                Text="事件类型" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Kind}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource Muted}"
                                Text="重置范围" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ResetType}" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource Muted}"
                                Text="公告时间" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding Announcement}" />
                        </Grid>
                        <Separator Margin="0,16" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

